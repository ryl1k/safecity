# SafeCity mobile env (Expo inlines EXPO_PUBLIC_* at build). Copy to .env.
# NOTE: a physical device/emulator can't reach the host's "localhost" — use your
# machine's LAN IP for the API (e.g. http://192.168.1.20:8080), or an Android
# emulator's 10.0.2.2. Leave EXPO_PUBLIC_API_URL empty to fall back to Supabase.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
