# ─── Supabase (Postgres+PostGIS, Auth, Storage) ───────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-side only (apps/api) — never ship to clients
DATABASE_URL=                     # direct Postgres/PostGIS connection (migrations, api)

# ─── OpenRouteService (accessible routing) ────────────────────
ORS_API_KEY=                      # hosted ORS; self-host Lviv extract is the fallback
ORS_BASE_URL=https://api.openrouteservice.org

# ─── Maps ─────────────────────────────────────────────────────
MAP_TILE_URL=                     # OSM vector tile source (self-host or provider)

# ─── ML tier (gRPC, server-side) ──────────────────────────────
ML_GRPC_URL=

# ─── Clients (public, EXPO_PUBLIC_ / NEXT_PUBLIC_ prefixes) ────
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=
