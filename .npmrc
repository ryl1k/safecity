# Copy packages into node_modules instead of hardlinking them to the global store.
# Prevents a `next build` (standalone file-tracing) from corrupting the shared store
# on Windows — the recurring "Cannot find module 'next/dist/...'" issue.
package-import-method=copy

# Flat node_modules. React Native / Metro / Babel expect a hoisted layout to
# resolve transitive deps (@babel/runtime, @expo/metro-runtime, etc.); pnpm's
# default isolated layout hides them and Metro bundling fails. Required for the
# Expo app in this monorepo.
node-linker=hoisted
